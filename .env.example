# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/proxyguard
# For MongoDB Atlas (Vercel / Cloud): mongodb+srv://<username>:<password>@cluster.mongodb.net/proxyguard?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proxyguard

# JWT Secret Key for Session Authentication
# In production & on Vercel, generate a cryptographically secure random string of at least 16 characters (recommended 32+):
# e.g., run in terminal: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# Initial Administrator Credentials (used when running: node createAdmin.js)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_secure_admin_password_here
