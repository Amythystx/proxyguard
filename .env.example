# Server Configuration
PORT=5000

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/proxyguard
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/proxyguard
MONGO_URI=mongodb://127.0.0.1:27017/proxyguard

# JWT Secret Key for Session Authentication
# In production, generate a secure random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here

# Initial Administrator Credentials (used when running: node createAdmin.js)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_secure_admin_password_here
